@startuml diagrama de estatico de "Carnes" 

abstract Class Carne{
    -tiempoParrilla: Number
    -estado: Estado
    +tiempoCoccion()
    +nombre()
    +seQuemo()
    +estaCocida()
    +cocinar(calor)
    +image()
    +miRecetaEs()
}

class Chorizo{
    <<override>> tiempoCoccion() 
    <<override>> nombre()
    <<override>> image()
}

class Asado{
    <<override>> tiempoCoccion() 
    <<override>> nombre()
    <<override>> image()
}

Carne <|-- Chorizo
Carne <|-- Asado 


@enduml