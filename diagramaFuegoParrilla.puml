@startuml polimorfimo y composicion parrilla


object parrilla <<object>>{
    +fuego: Fuego
    +carneActual = Carne
    
    +avivar()
    +asar()
    +remover(carne)
}

class Fuego{
    +calor()
    +imagenParrilla()
    +siguiente()
    'podriamos tener mas metodos pero creo con estos dos basta para entender la intefaz'
}

object apagado <<object>> {
    +calor()
    +imagenParrilla()
    +siguiente()
}

object bajo <<object>> {
    +calor()
