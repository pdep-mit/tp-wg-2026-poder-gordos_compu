import src.carnes.*
import src.parrilla.*
import src.asador.*


describe "Las carnes se cocinan en la parrilla y cambian su estado" {

  //como en los test no pasa el tiempo podemos usar times para que se repita la accion varias veces 

  const unAsado = new Asado(posicionEnSuelo = game.at(2,3))
  
  const unaTira = new TiraAsado()

  const unChori = new Chorizo(posicionEnSuelo = game.at(2, 3))

  test "un asado se cocina a fuego fuerte" {
    parrilla.fuego(fuerte)
    parrilla.carneActual(unAsado)
    6.times({i => parrilla.asar()})
    assert.that(unAsado.estaCocida())
  }

  test "un asado se quema a fuego fuerte" {
    parrilla.fuego(fuerte)
    parrilla.carneActual(unAsado)
    8.times({i => parrilla.asar()})
    assert.that(unAsado.seQuemo())
  }

  test "no se puede cocinar una tira de asado" {
    assert.throwsExceptionWithMessage("primero me tenes que cortar", { unaTira.ponerseEn(parrilla) })
  }

  test "un asado se cocina a fuego bajo " {
    parrilla.fuego(bajo)
    parrilla.carneActual(unAsado)
    16.times({i => parrilla.asar()})
    assert.that(unAsado.estaCocida())
  }

  //encontre un bug yey! 
  test "cocino un asado de mas y queda quemado"{
    parrilla.fuego(fuerte)
    parrilla.carneActual(unChori)
    16.times({i => parrilla.asar()})
    assert.equals("chori_quemado.png", unChori.image())

  }
}